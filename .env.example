# Pooler en modo transaccion (puerto 6543). Lo usa la app.
DATABASE_URL=
# Session pooler (puerto 5432). Lo usan migraciones y seed.
DATABASE_URL_MIGRATE=
# Postgres aislado para tests. Debe ser distinto de DATABASE_URL.
TEST_DATABASE_URL=
# Secreto largo y aleatorio: openssl rand -base64 48
JWT_SECRET=
# Slug de la organizacion donde se registran los usuarios nuevos.
DEMO_ORG_SLUG=acme
# URL publica de la app (http://localhost:3000 en local).
APP_ORIGIN=http://localhost:3000
